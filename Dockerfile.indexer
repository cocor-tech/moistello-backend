FROM golang:1.26.9-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
COPY third_party/chi-compat/go.mod ./third_party/chi-compat/go.mod
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /moistello-indexer ./cmd/indexer

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=builder /moistello-indexer /usr/bin/moistello-indexer
COPY config/ /etc/moistello/
ENTRYPOINT ["/usr/bin/moistello-indexer"]
