# Moistello Backend environment variables
# Copy to .env and adjust values for your environment. Scalar config keys use
# MOISTELLO_<SECTION>_<KEY> (uppercase, dots replaced by underscores).
# Most values below mirror config/config.yaml. Blank required secrets must be
# provided before startup. Never commit real secrets or mainnet keys.

# Runtime environment. Also accepts NODE_ENV.
MOISTELLO_ENVIRONMENT=development

# Server
MOISTELLO_SERVER_PORT=1100
MOISTELLO_SERVER_HOST=0.0.0.0
MOISTELLO_SERVER_READ_TIMEOUT=10s
MOISTELLO_SERVER_WRITE_TIMEOUT=30s
MOISTELLO_SERVER_MAX_HEADER_BYTES=1048576
MOISTELLO_SERVER_TLS_ENABLED=false
MOISTELLO_SERVER_TLS_CERT_PATH=
MOISTELLO_SERVER_TLS_KEY_PATH=
MOISTELLO_SERVER_HTTP_REDIRECT_PORT=80
MOISTELLO_SERVER_SHUTDOWN_DELAY=0s
MOISTELLO_SERVER_SHUTDOWN_TIMEOUT=30s
MOISTELLO_SERVER_MAX_BODY_BYTES=4194304
# Structured route overrides belong in config.yaml: server.max_body_bytes_routes.

# Database. DATABASE_URL is also accepted for the primary connection.
MOISTELLO_DATABASE_URL=
MOISTELLO_DATABASE_REPLICA_URL=
MOISTELLO_DATABASE_MAX_OPEN_CONNS=50
MOISTELLO_DATABASE_MAX_IDLE_CONNS=10
MOISTELLO_DATABASE_CONN_MAX_LIFETIME=30m
MOISTELLO_DATABASE_MIGRATION_PATH=

# Redis. REDIS_URL and REDIS_PASSWORD are also accepted.
MOISTELLO_REDIS_URL=redis://localhost:6379
MOISTELLO_REDIS_PASSWORD=
MOISTELLO_REDIS_DB=0
MOISTELLO_REDIS_POOL_SIZE=20

# RabbitMQ
MOISTELLO_RABBITMQ_URL=amqp://guest:guest@localhost:5672/
MOISTELLO_RABBITMQ_EXCHANGE=moistello.events
MOISTELLO_RABBITMQ_QUEUES_NOTIFICATIONS=moistello.notifications
MOISTELLO_RABBITMQ_QUEUES_WEBHOOKS=moistello.webhooks

# Stellar. Master keys are required at runtime; use testnet keys locally.
# The MOISTELLO_STELLAR_MASTER_* names are preferred; STELLAR_MASTER_* aliases
# are also supported. Never put a mainnet secret key in this file.
MOISTELLO_STELLAR_NETWORK=testnet
MOISTELLO_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
MOISTELLO_STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
MOISTELLO_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
MOISTELLO_STELLAR_MASTER_PUBLIC_KEY=
MOISTELLO_STELLAR_MASTER_SECRET_KEY=
MOISTELLO_STELLAR_USDC_ISSUER=GAX23V3WWDPPR5WRER3KTEUTDLSCGZYMSJY5FDRRKKCIQ4JADF5T27RC
MOISTELLO_STELLAR_WALLET_MIN_BALANCE=10
MOISTELLO_STELLAR_GOVERNANCE_TOKEN_CONTRACT_ID=
MOISTELLO_STELLAR_ESCROW_SWAP_CONTRACT_ID=
# Contract IDs are a structured map; configure contracts.* in config.yaml.

# Authentication and JWT. PEM variables take precedence over their file paths.
# JWT_PRIVATE_KEY / JWT_PUBLIC_KEY and the JWT_PREVIOUS_* aliases are supported.
MOISTELLO_AUTH_JWT_PRIVATE_KEY_PATH=./config/keys/jwt-private.pem
MOISTELLO_AUTH_JWT_PUBLIC_KEY_PATH=./config/keys/jwt-public.pem
MOISTELLO_AUTH_JWT_PRIVATE_KEY_PEM=
MOISTELLO_AUTH_JWT_PUBLIC_KEY_PEM=
MOISTELLO_AUTH_JWT_CURRENT_KID=
MOISTELLO_AUTH_JWT_PREVIOUS_PRIVATE_KEY_PATH=
MOISTELLO_AUTH_JWT_PREVIOUS_PUBLIC_KEY_PATH=
MOISTELLO_AUTH_JWT_PREVIOUS_PRIVATE_KEY_PEM=
MOISTELLO_AUTH_JWT_PREVIOUS_PUBLIC_KEY_PEM=
MOISTELLO_AUTH_JWT_PREVIOUS_KID=
MOISTELLO_AUTH_ACCESS_TOKEN_TTL=240m
MOISTELLO_AUTH_REFRESH_TOKEN_TTL=168h
MOISTELLO_AUTH_NONCE_TTL=5m
MOISTELLO_AUTH_ADMIN_API_KEY=
MOISTELLO_AUTH_ADMIN_API_KEY_SECONDARY=
MOISTELLO_AUTH_CLEANUP_INTERVAL=5m
MOISTELLO_AUTH_CLEANUP_JITTER=30s

# Application security secrets and password-hashing parameters.
MOISTELLO_SECURITY_WALLET_PEPPER=
MOISTELLO_SECURITY_ENCRYPTION_KEY=
MOISTELLO_SECURITY_ARGON2_TIME=1
MOISTELLO_SECURITY_ARGON2_MEMORY=65536
MOISTELLO_SECURITY_ARGON2_THREADS=4
# MOISTELLO_WALLET_PEPPER and ENCRYPTION_KEY are also accepted aliases.

# Brevo email provider. MOISTELLO_EMAIL_API_KEY and related legacy aliases work.
MOISTELLO_BREVO_API_KEY=
MOISTELLO_BREVO_FROM_EMAIL=noreply@moistello.com
MOISTELLO_BREVO_FROM_NAME=Moistello

# Indexer
MOISTELLO_INDEXER_POLL_INTERVAL=3s
MOISTELLO_INDEXER_BATCH_SIZE=50
MOISTELLO_INDEXER_START_LEDGER=0
MOISTELLO_INDEXER_MAX_CURSOR_LAG=2m
MOISTELLO_INDEXER_REORG_WINDOW=10
MOISTELLO_INDEXER_STALL_THRESHOLD=5m

# Notifications
MOISTELLO_NOTIFICATION_EMAIL_PROVIDER=
MOISTELLO_NOTIFICATION_EMAIL_API_KEY=
MOISTELLO_NOTIFICATION_EMAIL_FROM_ADDRESS=
MOISTELLO_NOTIFICATION_SMS_PROVIDER=
MOISTELLO_NOTIFICATION_SMS_ACCOUNT_SID=
MOISTELLO_NOTIFICATION_SMS_AUTH_TOKEN=
MOISTELLO_NOTIFICATION_SMS_FROM_NUMBER=
MOISTELLO_NOTIFICATION_PUSH_FCM_SERVER_KEY=

# CORS. ALLOWED_ORIGINS is also accepted. Origins, methods, and headers are
# comma-separated. If origins are blank, defaults are selected per environment.
MOISTELLO_CORS_ALLOWED_ORIGINS=
MOISTELLO_CORS_ALLOWED_METHODS=GET,POST,PATCH,DELETE,OPTIONS
MOISTELLO_CORS_ALLOWED_HEADERS=Authorization,X-CSRF-Token,Content-Type,X-Request-ID
MOISTELLO_CORS_ALLOW_CREDENTIALS=true
MOISTELLO_CORS_MAX_AGE=24h

# Rate limits. Redis failures are rejected by default (fail closed).
MOISTELLO_RATE_LIMIT_GLOBAL=100
MOISTELLO_RATE_LIMIT_AUTHENTICATED=300
MOISTELLO_RATE_LIMIT_AUTH=10
MOISTELLO_RATE_LIMIT_FAIL_CLOSED=true
MOISTELLO_RATE_LIMIT_OTP_LIMIT=5
MOISTELLO_RATE_LIMIT_OTP_WINDOW_SECONDS=900
MOISTELLO_RATE_LIMIT_SWAP_LIMIT=10
MOISTELLO_RATE_LIMIT_SWAP_WINDOW_SECONDS=60
MOISTELLO_RATE_LIMIT_CONTRIBUTE_LIMIT=10
MOISTELLO_RATE_LIMIT_CONTRIBUTE_WINDOW_SECONDS=60
MOISTELLO_RATE_LIMIT_WALLET_TRANSFER_LIMIT=5
MOISTELLO_RATE_LIMIT_WALLET_TRANSFER_WINDOW_SECONDS=60
MOISTELLO_RATE_LIMIT_REFERRAL_LIMIT=10
MOISTELLO_RATE_LIMIT_REFERRAL_WINDOW_SECONDS=3600
MOISTELLO_RATE_LIMIT_PASSWORD_RESET_IP_LIMIT=0
MOISTELLO_RATE_LIMIT_PASSWORD_RESET_ACCOUNT_LIMIT=0
MOISTELLO_RATE_LIMIT_PASSWORD_RESET_WINDOW_SECONDS=0
MOISTELLO_RATE_LIMIT_ADMIN_LIMIT=50
MOISTELLO_RATE_LIMIT_ADMIN_WINDOW_SECONDS=60

# Logging and tracing
MOISTELLO_LOGGING_LEVEL=debug
MOISTELLO_LOGGING_FORMAT=json
MOISTELLO_LOGGING_OUTPUT=stdout
MOISTELLO_TRACING_ENABLED=false
MOISTELLO_TRACING_COLLECTOR_ENDPOINT=localhost:4317
MOISTELLO_TRACING_SERVICE_NAME=moistello-api
MOISTELLO_TRACING_SAMPLE_RATE=0.1

# Yellow Card. YELLOW_CARD_* aliases are also accepted.
MOISTELLO_YELLOW_CARD_API_KEY=
MOISTELLO_YELLOW_CARD_API_SECRET=
MOISTELLO_YELLOW_CARD_WEBHOOK_SECRET=
MOISTELLO_YELLOW_CARD_MAX_DEPOSIT_NGN=0
MOISTELLO_YELLOW_CARD_MAX_WITHDRAW_USDC=0
MOISTELLO_YELLOW_CARD_DAILY_DEPOSIT_CAP_NGN=0
MOISTELLO_YELLOW_CARD_DAILY_WITHDRAW_CAP_USDC=0
# Per-currency caps are a structured map; configure yellow_card.currency_caps
# in config.yaml (max_deposit, max_withdraw, daily_deposit_cap, daily_withdraw_cap).

# Mobile money for non-NGN African markets. A provider is enabled only when
# its required credentials are configured.
MOISTELLO_MOBILE_MONEY_CALLBACK_BASE_URL=
MOISTELLO_MOBILE_MONEY_RECONCILE_INTERVAL_MINUTES=5
MOISTELLO_MOBILE_MONEY_MPESA_CONSUMER_KEY=
MOISTELLO_MOBILE_MONEY_MPESA_CONSUMER_SECRET=
MOISTELLO_MOBILE_MONEY_MPESA_SHORTCODE=
MOISTELLO_MOBILE_MONEY_MPESA_PASSKEY=
MOISTELLO_MOBILE_MONEY_MPESA_SECURITY_CREDENTIAL=
MOISTELLO_MOBILE_MONEY_MPESA_INITIATOR_NAME=
MOISTELLO_MOBILE_MONEY_MPESA_SANDBOX=true
MOISTELLO_MOBILE_MONEY_MTN_SUBSCRIPTION_KEY=
MOISTELLO_MOBILE_MONEY_MTN_API_USER=
MOISTELLO_MOBILE_MONEY_MTN_API_KEY=
MOISTELLO_MOBILE_MONEY_MTN_TARGET_CURRENCY=
MOISTELLO_MOBILE_MONEY_MTN_SANDBOX=true
MOISTELLO_MOBILE_MONEY_AIRTEL_CLIENT_ID=
MOISTELLO_MOBILE_MONEY_AIRTEL_CLIENT_SECRET=
MOISTELLO_MOBILE_MONEY_AIRTEL_COUNTRY=
MOISTELLO_MOBILE_MONEY_AIRTEL_TARGET_CURRENCY=
MOISTELLO_MOBILE_MONEY_AIRTEL_SANDBOX=true

# Swap and governance
MOISTELLO_SWAP_SWEEP_INTERVAL=1m
MOISTELLO_GOVERNANCE_EXECUTION_TIMELOCK=48h
MOISTELLO_GOVERNANCE_CANCEL_THRESHOLD_PCT=33